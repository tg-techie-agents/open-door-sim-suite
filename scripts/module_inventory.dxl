// For each formal module directly inside one folder or project: how many
// objects, how many requirements, and the latest baseline. Changes nothing.

// ==== settings: change these ================================================
string FOLDER_PATH = "/Greenhouse Demo"
// ============================================================================

// The module at a path: the one already open, in whatever mode, else read().
Module moduleAt(string path) {
    ModName_ named = module(path)
    if (null named) return null
    if (open named) return data(moduleVersion(named))
    return read(path, false)
}

Folder here = folder(FOLDER_PATH)
if (null here) {
    print "no folder " FOLDER_PATH "\n"
    halt
}

Item entry
for entry in here do {
    if (type(entry) != "Formal") continue
    if (isDeleted entry) continue
    Module m = moduleAt(fullName(entry))
    if (null m) {
        print "WARNING: cannot open " fullName(entry) "\n"
        continue
    }
    int objects = 0, requirements = 0
    Object o
    for o in entire(m) do {
        if (isDeleted o) continue
        objects++
        string body = o."Object Text"
        if (body != "") requirements++
    }
    Baseline newest = getMostRecentBaseline(m)
    string latest = "none"
    if (!null newest) latest = major(newest) "." minor(newest) ""
    print name(entry) ": " objects " objects, " requirements " with text, latest baseline " latest "\n"
}
